# =====================================================================
# london-property-ai — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. This project's .env is independent from
# any other project (e.g. the hostel WhatsApp agent) — do not share values.
# =====================================================================

# ---------- General ----------
NODE_ENV=development                 # development | production
APP_NAME=london-property-ai
LOG_LEVEL=info                       # debug | info | warn | error

# ---------- API server ----------
API_PORT=4000
API_BASE_URL=https://api.yourdomain.com
DASHBOARD_BASE_URL=https://app.yourdomain.com

# ---------- Auth ----------
JWT_ACCESS_SECRET=changeme_generate_a_long_random_string
JWT_REFRESH_SECRET=changeme_generate_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- Database (own Postgres instance for THIS project only) ----------
DATABASE_URL=postgresql://lpai_user:changeme@postgres:5432/lpai_db
POSTGRES_USER=lpai_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lpai_db

# ---------- Redis (own instance for THIS project only) ----------
REDIS_URL=redis://redis:6379

# ---------- Cloudflare R2 (own bucket for THIS project only) ----------
R2_ACCOUNT_ID=changeme
R2_ACCESS_KEY_ID=changeme
R2_SECRET_ACCESS_KEY=changeme
R2_BUCKET_NAME=london-property-ai-media
R2_PUBLIC_HOSTNAME=            # leave blank if bucket is private (recommended)

# ---------- AI Provider abstraction ----------
AI_PROVIDER=anthropic                # anthropic | openai | gemini
AI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=changeme
OPENAI_API_KEY=                      # only needed if AI_PROVIDER=openai
GOOGLE_API_KEY=                      # only needed if AI_PROVIDER=gemini

# ---------- Communications: Email ----------
EMAIL_PROVIDER=resend                # resend | postmark | smtp
RESEND_API_KEY=changeme
EMAIL_FROM_ADDRESS=leads@yourdomain.com

# ---------- Communications: WhatsApp (added in a later phase) ----------
WHATSAPP_PROVIDER=                   # meta_cloud_api | twilio (leave blank until Phase 7)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---------- Communications: SMS (optional, later phase) ----------
SMS_PROVIDER=
SMS_API_KEY=

# ---------- Human notification channel (for AI escalation) ----------
NOTIFY_CHANNEL=email                 # email | telegram | slack_webhook
NOTIFY_EMAIL_TO=you@yourdomain.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# ---------- Error tracking / monitoring ----------
SENTRY_DSN=

# ---------- Rate limiting ----------
RATE_LIMIT_MAX=100                   # requests
RATE_LIMIT_WINDOW=1m

# ---------- Compliance ----------
FOLLOWUP_QUIET_HOURS_START=21:00
FOLLOWUP_QUIET_HOURS_END=08:00
FOLLOWUP_MIN_HOURS_BETWEEN_MESSAGES=48
